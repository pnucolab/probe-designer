# Copy to .env and adjust for your host. .env is gitignored and never committed.

# --- Celery / Redis -------------------------------------------------------
# Defaults below match the `redis` service in docker-compose.yml.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8002

# Comma-separated list of origins allowed to call the API from a browser.
# Set this to the exact origin(s) you serve the frontend from. Do NOT use "*":
# the API sends credentialed CORS responses.
ALLOWED_ORIGINS=http://localhost:4000

# --- GPU ------------------------------------------------------------------
# GPU device node exposed to the worker container. List the node your host
# actually provides (/dev/nvidia0, /dev/nvidia1, ...). Defaults to /dev/nvidia0.
NVIDIA_DEVICE=/dev/nvidia0
